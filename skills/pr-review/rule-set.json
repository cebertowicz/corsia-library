{
 "schema": "qa.review-rule-set/1",
 "mode": "shadow",
 "run_seconds": 300,
 "repos": [],
 "repo_checkouts": {},
 "worker_workflow": "pr-reviewer",
 "extended_window_base": null,
 "screen_workflow": "github-pr-screen",
 "agents_login": "",
 "sme": null,
 "no_result_retry_bound": 2,
 "mergeability_reread_bound": 3,
 "status_contexts": {
  "live": {
   "verdict": "llm-review",
   "presence": "llm-review-present"
  },
  "shadow": {
   "verdict": "llm-review-shadow",
   "presence": null
  }
 },
 "standards": [
  "docs/review-standards.md"
 ],
 "standards_local_root": null,
 "reviewer_standards": "repository-standards",
 "paths": {
  "state": "state/review-gate",
  "staging": "staging",
  "shadow_record": "records/review-shadow"
 },
 "scripts": {
  "evaluate": "scripts/review_gate_evaluate.py",
  "stage_review": "scripts/review_gate_stage.py",
  "publish": "scripts/review_gate_publish.py"
 },
 "rules": [
  {
   "id": "1-opened",
   "connector": "github",
   "event_type": "pr.opened",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    }
   ]
  },
  {
   "id": "1-pushed",
   "connector": "github",
   "event_type": "pr.synchronize",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    }
   ]
  },
  {
   "id": "1-ready",
   "connector": "github",
   "event_type": "pr.ready_for_review",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    }
   ]
  },
  {
   "id": "1-checks",
   "connector": "github",
   "event_type": "head.checks_completed",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    }
   ]
  },
  {
   "id": "1-labeled",
   "connector": "github",
   "event_type": "pr.labeled",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    },
    {
     "field": "label",
     "op": "prefix",
     "value": "qa/"
    }
   ]
  },
  {
   "id": "1-unlabeled",
   "connector": "github",
   "event_type": "pr.unlabeled",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    },
    {
     "field": "label",
     "op": "prefix",
     "value": "qa/"
    }
   ]
  },
  {
   "id": "1-closed",
   "connector": "github",
   "event_type": "pr.closed",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    }
   ]
  },
  {
   "id": "1-merged",
   "connector": "github",
   "event_type": "pr.merged",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    }
   ]
  },
  {
   "id": "2-comment",
   "connector": "github",
   "event_type": "pr_comment.created",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    },
    {
     "field": "has_reviewer_marker",
     "op": "not_eq",
     "value": true
    }
   ]
  },
  {
   "id": "2-review",
   "connector": "github",
   "event_type": "review.submitted",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    }
   ]
  },
  {
   "id": "3a-stage",
   "connector": "qa",
   "event_type": "review_stage_requested",
   "action": "run_script",
   "script": "stage_review",
   "match": []
  },
  {
   "id": "3-start",
   "connector": "qa",
   "event_type": "review_requested",
   "action": "start_worker",
   "workflow": "pr-reviewer",
   "request_identity_fact": "request_identity",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    },
    {
     "field": "base_ref",
     "op": "not_eq",
     "value": "$extended_window_base"
    }
   ]
  },
  {
   "id": "3-start-main",
   "connector": "qa",
   "event_type": "review_requested",
   "action": "start_worker",
   "workflow": "pr-reviewer",
   "worker_profile": "main",
   "request_identity_fact": "request_identity",
   "match": [
    {
     "field": "repo",
     "op": "in",
     "value": "$repos"
    },
    {
     "field": "base_ref",
     "op": "eq",
     "value": "$extended_window_base"
    }
   ]
  },
  {
   "id": "4-result",
   "connector": "worker",
   "event_type": "result",
   "action": "run_script",
   "script": "publish",
   "match": [
    {
     "field": "workflow",
     "op": "prefix",
     "value": "pr-reviewer@"
    }
   ]
  },
  {
   "id": "4-no-result",
   "connector": "worker",
   "event_type": "no_result",
   "action": "run_script",
   "script": "publish",
   "match": [
    {
     "field": "workflow",
     "op": "prefix",
     "value": "pr-reviewer@"
    }
   ]
  },
  {
   "id": "4-refused",
   "connector": "worker",
   "event_type": "no_result",
   "action": "run_script",
   "script": "publish",
   "match": [
    {
     "field": "workflow",
     "op": "eq",
     "value": "pr-reviewer"
    }
   ]
  },
  {
   "id": "4b-status",
   "connector": "qa",
   "event_type": "review_status",
   "action": "run_script",
   "script": "publish",
   "match": []
  },
  {
   "id": "5-result",
   "connector": "worker",
   "event_type": "result",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "workflow",
     "op": "prefix",
     "value": "pr-reviewer@"
    }
   ]
  },
  {
   "id": "5-no-result",
   "connector": "worker",
   "event_type": "no_result",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "workflow",
     "op": "prefix",
     "value": "pr-reviewer@"
    }
   ]
  },
  {
   "id": "5-refused",
   "connector": "worker",
   "event_type": "no_result",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "workflow",
     "op": "eq",
     "value": "pr-reviewer"
    }
   ]
  },
  {
   "id": "6a-screen-result",
   "connector": "worker",
   "event_type": "result",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "workflow",
     "op": "prefix",
     "value": "github-pr-screen@"
    }
   ]
  },
  {
   "id": "6a-screen-no-result",
   "connector": "worker",
   "event_type": "no_result",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "workflow",
     "op": "prefix",
     "value": "github-pr-screen@"
    }
   ]
  },
  {
   "id": "6a-screen-refused",
   "connector": "worker",
   "event_type": "no_result",
   "action": "run_script",
   "script": "evaluate",
   "match": [
    {
     "field": "workflow",
     "op": "eq",
     "value": "github-pr-screen"
    }
   ]
  },
  {
   "id": "7-needs-turn",
   "connector": "qa",
   "event_type": "review_needs_turn",
   "action": "deliver",
   "to": "self",
   "mode": "wake",
   "match": []
  }
 ],
 "not_in_this_rule_set": {
  "screen": "The platform supplies the pull-request screen workflow.",
  "approval": "Configure repository approval policy separately."
 }
}
